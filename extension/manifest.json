{
  "manifest_version": 3,
  "name": "晨雾起始页",
  "version": "1.0.0",
  "description": "搜索、常用站点、天气与待办便签，四套主题可切换的新标签页。",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "host_permissions": [
    "https://geocoding-api.open-meteo.com/*",
    "https://api.open-meteo.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "offline_enabled": true
}